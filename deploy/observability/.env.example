# Пример переменных для deploy/observability/docker-compose.yml.
# Скопируйте в deploy/observability/.env и подставьте реальные значения НА VPS.
# НИКОГДА не коммитьте заполненный файл: .env игнорируется .gitignore.

# Обязательно: пароль администратора Grafana (меняется при первом запуске).
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-long-random-value

# Пароль роли grafana в PostgreSQL (совпадает с POSTGRES_GRAFANA_PASSWORD в compose).
POSTGRES_GRAFANA_PASSWORD=replace-me-with-a-long-random-value

# Пароль суперпользователя PostgreSQL для pg_dump/p.sql из backup-observability.sh.
POSTGRES_OBSERVABILITY_PASSWORD=replace-me-with-a-long-random-value

# Telegram contact point для Grafana Alerting.
# В репозитории хранятся только имена переменных, не значения.
GRAFANA_TELEGRAM_BOT_TOKEN=replace-me-with-telegram-bot-token
GRAFANA_TELEGRAM_CHAT_ID=replace-me-with-telegram-chat-id

# Шифрование бэкапов: только имена переменных, значения задаются на VPS.
# SREDA_BACKUP_AGE_RECIPIENT=<публичный получатель age>
# SREDA_BACKUP_AGE_IDENTITY=<путь к приватному identity age>
