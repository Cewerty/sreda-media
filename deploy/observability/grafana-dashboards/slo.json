{
  "uid": "sreda-slo",
  "title": "Sreda SLO",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability 30d (%)",
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "avg_over_time(probe_success{job=\"sreda\"}[30d]) * 100"}],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latency p95 (ms)",
      "targets": [{"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(sreda_request_duration_seconds_bucket[5m])) by (le)) * 1000"}],
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backup age (hours)",
      "targets": [{"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - backup_last_success_timestamp"}],
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget remaining (%)",
      "targets": [{"refId": "D", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "clamp_min((1 - (1 - avg_over_time(probe_success{job=\"sreda\"}[30d])) / 0.01) * 100, 0)"}],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    }
  ]
}
