{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreda-media.local/contracts/drill-contract.v1.json",
  "title": "Sreda Media drill contract v1",
  "description": "Machine-readable evidence of a drill run. SKIP is not PASS; expired evidence is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "generated_at",
    "ttl_until",
    "mode",
    "commit",
    "artifact_sha256",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "drill-contract/v1"
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the script or workflow that emitted the contract."
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "ttl_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "mode": {
      "enum": ["drill", "dry-run", "standby", "active", "real", "static", "simulated", "skipped"],
      "description": "Only active/real modes are authoritative for production decisions."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prev_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical SHA-256 of the preceding contract for hash chaining."
    },
    "target": {
      "type": "string",
      "description": "Logical target of the drill; no real hosts or addresses."
    },
    "required_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "proves", "does_not_prove"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "SKIP", "FAIL"]},
          "proves": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "does_not_prove": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "skip_reason": {
            "enum": ["not_applicable", "blocked", "not_run", "missing_tool", "missing_secret"]
          },
          "evidence": {"type": "string"}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
