// Локальный Alloy для разработчиков: читает только примеры JSONL из репозитория.
// Не монтирует хостовые логи Caddy и Docker — локальный запуск ничему не мешает.

logging {
  level = "info"
}

loki.source.file "dev_examples" {
  targets = [{
    __path__    = "/var/log/sreda-dev/*.jsonl"
    job         = "dev-examples"
    component   = "dev"
    environment = "development"
  }]

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
