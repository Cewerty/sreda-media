---
import { getEntry, render } from "astro:content";

const article = await getEntry("articles", "test-article");

if (!article) {
    throw new Error("Не найдена тестовая статья test-article");
}
const { Content } = await render(article);
---
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sreda Media</title>
</head>
<body>
    <main>
        <article>
            <h1>{article.data.title}</h1>
            <Content />
        </article>
    </main>
</body>
</html>