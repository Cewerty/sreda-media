---
import { getEntry, render } from "astro:content";

const article = await getEntry("articles", "article-001");

if (!article) {
  throw new Error("Не найдена тестовая статья article-001");
}
const { Content } = await render(article);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sreda Media</title>
  </head>
  <body>
    <main>
      <article>
        <h1>{article.data.title}</h1>
        <Content />
      </article>
    </main>
  </body>
</html>
