# Шаблон окружения apps/cms-api. Скопируй в .env; сам .env в Git не хранится.
# Typed config: config/runtime.py (AppSettings, #41), ADR 0015 §2.
# SQLite нет ни в одном профиле — только PostgreSQL (ADR 0015 §3).

# --- Общие ---
DJANGO_ENV=dev
DJANGO_DEBUG=1
# Синтетический ключ для локального запуска.
# В production обязателен собственный стойкий секрет.
DJANGO_SECRET_KEY=django-insecure-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RELEASE=
LOG_LEVEL=INFO
# Окружение без tzdata (локальный pgserver) может выставить GMT.
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL: только он (ADR 0015 §3) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sreda
POSTGRES_USER=sreda
POSTGRES_PASSWORD=sreda
# libpq connect_timeout, секунды.
POSTGRES_CONNECT_TIMEOUT=5
# -c statement_timeout=<ms>, миллисекунды.
POSTGRES_STATEMENT_TIMEOUT=3000
# Общий бюджет asyncio.wait_for для readiness-проб (#28, Q2).
READINESS_TIMEOUT_SECONDS=1.0

# --- Почта: SMTP и в dev, и в prod (console/locmem дают mail.E001) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@sreda.sielom.ru

# --- DMR ---
DMR_VALIDATE_RESPONSES=1
DMR_SEMANTIC_RESPONSES=1
