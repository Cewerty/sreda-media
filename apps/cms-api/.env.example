# Шаблон окружения apps/cms-api для локального запуска и config_check.py.
# Скопируй в .env; сам .env в Git не хранится.
# Полная env-конфигурация, PostgreSQL и secrets CI — #26/#14 (ADR 0015 §2).

# dev (по умолчанию) | production
DJANGO_ENV=dev

# Локально можно оставить пустым: работает dev-плейсхолдер из settings.py.
# В production обязателен; config_check.py проверит, что это не плейсхолдер.
DJANGO_SECRET_KEY=

# 1 — локальная разработка, 0 — prod-профиль.
DJANGO_DEBUG=1
