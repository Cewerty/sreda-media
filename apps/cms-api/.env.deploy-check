# Синтетический production-набор для `just deploy-strict` (входит в just check).
# НЕ боевые секреты: check --deploy не открывает соединений и не шлёт писем,
# ему нужны только значения в settings. Подставляется через `uv run --env-file`.
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bcde
DJANGO_ALLOWED_HOSTS=sreda.sielom.ru,cms.sreda.sielom.ru
RELEASE=deploy-check
LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sreda
POSTGRES_USER=sreda
POSTGRES_PASSWORD=deploy-check-only
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT=3000
READINESS_TIMEOUT_SECONDS=1.0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@sreda.sielom.ru

DMR_VALIDATE_RESPONSES=1
DMR_SEMANTIC_RESPONSES=1
